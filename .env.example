# ── Core application ────────────────────────────────────────────────────────
# Local PostgreSQL. Production must use the managed PostgreSQL connection string.
DATABASE_URL="postgresql://USER@localhost:5432/apex_coach?schema=public"

# Signing key for the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-random-string-of-at-least-32-characters"

# Canonical URL used for QR codes and hosted checkout return URLs.
# Development example; production must be the real HTTPS domain.
APP_URL="http://localhost:3400"

# Optional. Where the check scripts point; defaults to http://localhost:3400.
# CHECK_BASE_URL="http://localhost:3400"

# ── Dodo Payments ──────────────────────────────────────────────────────────
#
# Development/test only: these may be blank and the app uses the existing
# simulated payment flow without charging a card.
#
# Production is fail-closed: all five Dodo variables below are required and
# DODO_PAYMENTS_ENVIRONMENT must be live_mode. A production deployment can
# never silently grant access through simulated payments.
#
# Bearer token. Test keys start dodo_test_, live keys dodo_live_.
# Dashboard > Developer > API Keys.
DODO_PAYMENTS_API_KEY=""

# Secret used to verify webhook signatures. This must be different from the API key.
# Dashboard > Developer > Webhooks > (your endpoint) > Signing secret.
DODO_PAYMENTS_WEBHOOK_KEY=""

# test_mode for development/test deployments; live_mode is required in production.
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# The two products, from Dashboard > Products. Ids look like pdt_xxxxxxxx.
DODO_PRODUCT_ID_MONTHLY=""
DODO_PRODUCT_ID_ANNUAL=""

# Charge eligible buyers in their local currency. Enabled by default; set to 0
# only as a temporary fallback for an account that has not enabled the required
# currencies in Dodo.
DODO_ADAPTIVE_CURRENCY="1"
