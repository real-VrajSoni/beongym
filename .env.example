# Local PostgreSQL. Create the database first: createdb apex_coach
DATABASE_URL="postgresql://USER@localhost:5432/apex_coach?schema=public"

# Signing key for the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-random-string-of-at-least-32-characters"

# Where the app is reachable from a phone. This is what the check-in QR encodes,
# so on a local network it must be the machine's LAN address (not localhost) for
# a scan to work — e.g. http://192.168.1.20:3400. In production, the real domain.
APP_URL="http://localhost:3400"

# Optional. Where the check scripts point; defaults to http://localhost:3400.
# CHECK_BASE_URL="http://localhost:3400"

# ── Dodo Payments ──────────────────────────────────────────────────────────
#
# Leave these blank and the app runs in simulated mode: orders still go through
# the real PENDING -> provision state machine, nothing calls out to a gateway,
# and `npm run db:seed` and the check suites keep working. Fill them in and the
# same code paths talk to Dodo instead. The UI says which mode it is in.
#
# Bearer token. Test keys start dodo_test_, live keys dodo_live_.
# Dashboard > Developer > API Keys.
DODO_PAYMENTS_API_KEY=""

# Secret used to verify webhook signatures. A different value from the API key.
# Dashboard > Developer > Webhooks > (your endpoint) > Signing secret.
DODO_PAYMENTS_WEBHOOK_KEY=""

# test_mode or live_mode. The SDK defaults to live_mode when this is unset,
# which is the wrong default to inherit by accident — so it is explicit here.
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# The two products, from Dashboard > Products. Ids look like pdt_xxxxxxxx.
# One product per plan, priced to match lib/platform-plans.ts: $20 and $149.
DODO_PRODUCT_ID_MONTHLY=""
DODO_PRODUCT_ID_ANNUAL=""
